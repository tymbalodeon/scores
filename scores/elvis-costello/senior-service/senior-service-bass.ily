\version "2.25.24"

seniorServiceBass = \relative c {
  \key f \major
  \clef "bass"

  | f4 f r8 g g4
  | R1
  | f4 f r8 g g4
  | r2 r4 r8 f'

  | f,4 f r8 g g4
  | r2 r4 r8 f'
  | f,4 f r8 g g4
  | R1

  \mark \default

  | f8. f16 d8 g r2
  | r2 a8 a g4
  | f8. d16 d8 g r d d4
  | r2 a8 a c4 

  | f8. f16 d8 g r2
  | r2 a8 a g4
  | f8. d16 d8 g r d d4
  | r2 a8 a c4 

  \mark \default

  | d8 d4 a8 d d4 a8
  | d8 d4 d8 g,8 g g4
  | d'8 d4 a8 d d4 a8
  | d8 d4 d8 g,8 g g4

  | d'8 d4 a8 d d4 a8
  | d8 d4 d8 g,8 g g4
  | c'4 bf a g
  | f e d8 c c4

  \mark \default

  | f8. f16 d8 g r2
  | r2 a8 a g4
  | f8. d16 d8 g r d d4
  | r2 a8 a c4 

  | f8. f16 d8 g r2
  | r2 a8 a g4
  | f8. d16 d8 g r d d4
  | r2 a8 a c4 

  | f1 ~
  | f2 bf,4 bf
  | f1' ~
  | f2 bf,4 bf

  | f1 ~
  | f2 bf4 bf
  | f1 ~
  | f2 bf4 bf

  \mark \default

  | f'8. f16 d8 g r d'16 -> d -> d -> d -> d -> d ->
  | d4 -> r a8 a g4
  | f8. d16 d8 g r d d4
  | r2 a8 a c4 

  | f8. f16 d8 g r2
  | r2 a8 a g4
  | f8. d16 d8 g r d d4
  | r2 a8 a c4 

  \mark \default

  | d8 d4 a8 d d4 a8
  | d8 d4 d8 g,8 g g4
  | d'8 d4 a8 d d4 a8
  | d8 d4 d8 g,8 g g4

  | d'8 d4 a8 d d4 a8
  | d8 d4 d8 g,8 g g4
  | c'4 bf a g
  | f e d8 c c4

  \mark \default

  | f8. f16 d8 g r2
  | r2 a8 a g4
  | f8. d16 d8 g r d d4
  | r2 a8 a c4 

  | f8. f16 d8 g r2
  | r2 a8 a g4
  | f8. d16 d8 g r d d4
  | r2 a8 a c4 

  | f1 ~
  | f2 bf,4 bf
  | f1' ~
  | f2 bf,4 bf

  \time 2/4

  | gf4 -- ^\markup rit. gf --

  \time 4/4

  | f4 -> r2.

  \bar "|."
}
